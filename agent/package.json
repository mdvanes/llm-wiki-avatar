{
  "name": "llm-wiki-avatar-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LiveKit voice agent that answers questions about a markdown LLM wiki.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node src/main.ts dev",
    "start": "node src/main.ts start",
    "console": "node src/main.ts console",
    "download-files": "livekit-agents download-files",
    "test": "vitest --run --exclude 'test/evals/**'",
    "eval": "vitest --run test/evals",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@livekit/agents": "1.9.1",
    "@livekit/agents-plugin-openai": "1.9.1",
    "@livekit/rtc-node": "^1.1.0",
    "chokidar": "^5.0.0",
    "dotenv": "^18.0.4",
    "minisearch": "^7.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "livekit-server-sdk": "^2.19.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
