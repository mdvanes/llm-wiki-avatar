# Copy to .env and adjust. Used by the agent and frontend (npm run dev) and by docker compose.
# Every setting has a working default for local development.

# --- Wiki ------------------------------------------------------------------
# Native runs: path to the markdown wiki (relative to the repo root or absolute).
WIKI_DIR=sample-wiki
# docker compose: host folder mounted read-only into the containers.
WIKI_PATH=./sample-wiki

# --- LLM (any OpenAI-compatible server; Ollama by default) -----------------
LLM_BASE_URL=http://localhost:11434/v1
# docker compose: how the agent container reaches the LLM (native Ollama on the host by default;
# use http://ollama:11434/v1 with `--profile ollama`).
LLM_BASE_URL_DOCKER=http://host.docker.internal:11434/v1
LLM_MODEL=qwen3:4b-instruct
LLM_API_KEY=ollama
# For reasoning models such as qwen3.5, "none" disables thinking (much faster first word).
# LLM_REASONING_EFFORT=none
# LLM_TEMPERATURE=0.3

# --- Speech (Speaches: faster-whisper STT, Kokoro/Piper TTS) ----------------
SPEACHES_URL=http://localhost:8000/v1
STT_MODEL=Systran/faster-whisper-small
# Systran/faster-whisper-medium: clearly better Dutch (with English tech terms), but slower on CPU.
# Snap near-miss transcriptions to hotwords (vocab/*.txt).
# STT_FUZZY_CORRECTION=true
TTS_EN_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
# Female voices (the "female" options in the UI).
TTS_EN_VOICE=af_heart
TTS_NL_MODEL=speaches-ai/piper-nl_BE-nathalie-medium
TTS_NL_VOICE=nathalie
# Male voices (the "male" options in the UI).
# TTS_EN_MALE_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_EN_MALE_VOICE=am_michael
TTS_NL_MALE_MODEL=speaches-ai/piper-nl_BE-rdh-medium
TTS_NL_MALE_VOICE=rdh
# Voice until the user picks one in the browser: off (text replies only), female or male.
# DEFAULT_VOICE=female
# Point one language (or its male voice) at another OpenAI-compatible TTS server:
# TTS_NL_BASE_URL=http://localhost:8001/v1
# TTS_NL_MALE_BASE_URL=http://localhost:8001/v1
# TTS_SPEED=1
# Kokoro-FastAPI with word timestamps, for "Voice and avatar, female (premium)" (English, af_heart only).
# Start it with: docker compose --profile premium up (compose uses KOKORO_URL_DOCKER, default http://kokoro:8880).
# Leave empty to disable; if it is unreachable, the premium option falls back to the regular voice.
KOKORO_URL=http://localhost:8880

# --- Languages ---------------------------------------------------------------
# Used when the browser does not send a language (en | nl).
DEFAULT_LANGUAGE=en

# --- LiveKit (defaults match `livekit-server --dev`) --------------------------
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
AGENT_NAME=llm-wiki-avatar
# docker compose: the LiveKit URL as seen from the browser.
# LIVEKIT_PUBLIC_URL=ws://localhost:7880
# docker-compose.prod.yml: the host IP that browsers use for WebRTC media (required there).
# LIVEKIT_NODE_IP=
# Port for the web app (docker compose and `npm run dev:frontend`).
# FRONTEND_PORT=3000

# --- Tuning --------------------------------------------------------------------
# WIKI_CONTEXT_CHARS=1800
# WIKI_PAGE_MAX_CHARS=6000
# WIKI_WATCH_POLL=false
# Role of the injected wiki excerpts; try "user" if your model ignores mid-conversation system messages.
# WIKI_CONTEXT_ROLE=system
