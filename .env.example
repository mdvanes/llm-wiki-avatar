# Copy to .env and adjust. Never commit real keys or use NEXT_PUBLIC_* for secrets.
# Native services prefer .env.local over .env; existing environment variables win.
# Compose reads .env; add --env-file .env.local to use that file instead.

# --- Wiki ------------------------------------------------------------------
# Ordered sources. Relative paths resolve from the repo root.
# Compose custom folders must be under ./wikis. First source wins ambiguous titles.
WIKI_SOURCES='[{"id":"wiki","name":"Wiki","path":"sample-wiki"}]'
# WIKI_SOURCES='[{"id":"product","name":"Product Wiki","path":"wikis/product"},{"id":"engineering","name":"Engineering Wiki","path":"wikis/engineering"}]'

# --- LLM: native Ollama (default) ------------------------------------------
# Install/start Ollama, then run: ollama pull qwen3:4b-instruct
# Models must support chat completions, streaming and tool/function calling.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:4b-instruct
LLM_API_KEY=ollama
# Docker endpoint override: takes precedence over LLM_BASE_URL.
LLM_BASE_URL_DOCKER=http://host.docker.internal:11434/v1

# --- Alternative: third-party OpenAI-compatible API ------------------------
# Replace the active LLM settings above; replace model/key placeholders.
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=YOUR_TOOL_CAPABLE_MODEL
# LLM_API_KEY=YOUR_API_KEY
# IMPORTANT: remove LLM_BASE_URL_DOCKER or change it to the same API URL.
# Native Anthropic/Gemini APIs require an OpenAI-compatible gateway.
# Hosted providers receive questions, wiki context, tool results and restored history.
# Calls can incur charges. Restrict app access before enabling a paid API.

# --- Alternative: Ollama in Docker -----------------------------------------
# Keep Ollama provider/model/key settings; change the endpoint override:
# LLM_BASE_URL_DOCKER=http://ollama:11434/v1
# docker compose --profile ollama up -d --build
# Ollama images/services are optional; the profile downloads LLM_MODEL.
# Do not enable the profile with a hosted API model ID.
# Production: add -f docker-compose.prod.yml and omit --build.

# --- Apply changes / manual fallback ---------------------------------------
# Restore Ollama provider/model/key/endpoints to switch back; no automatic fallback.
# Start native Ollama or enable its Docker profile, then recreate containers:
# docker compose up -d --build --force-recreate agent frontend
# Native: restart agent and frontend. A Docker restart does not reload environment.
# Start a new conversation. Setup guidance is on /settings in English/Dutch.

# --- LLM tuning -----------------------------------------------------------
# Set reasoning effort only when supported; local qwen3.5 supports "none".
# LLM_REASONING_EFFORT=none
# LLM_TEMPERATURE=0.3
# LLM_TIMEOUT_S=90
# One tiny chat request per session start to report LLM problems early (costs a few tokens on paid APIs).
# LLM_PREFLIGHT=true

# --- Browser speech and language ------------------------------------------
# Download recognition models and voices on /settings; speech stays in the browser.
# DEFAULT_VOICE=female                 # off | female | male
DEFAULT_LANGUAGE=en                   # en | nl

# --- LiveKit --------------------------------------------------------------
# Development defaults. Production requires real keys and a secret >=32 characters.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
AGENT_NAME=llm-wiki-avatar
# LIVEKIT_PUBLIC_URL=ws://localhost:7880 # URL reachable by the browser
# LIVEKIT_NODE_IP=                     # Required WebRTC host IP in production
# FRONTEND_PORT=3000

# --- Wiki tuning ----------------------------------------------------------
# WIKI_CONTEXT_CHARS=1800
# WIKI_INDEX_MAX_CHARS=4000
# WIKI_PAGE_MAX_CHARS=6000
# WIKI_WATCH_POLL=false
# WIKI_CONTEXT_ROLE=system             # Try user if the model ignores system context